{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppLogCleanup": {
    "RetentionMonths": 1,
    "BatchSize": 5000,
    "Cron": "30 0 * * *"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Pie2.0.Api"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "AppLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 50,
            "batchPeriod": "00:00:05",
            "eagerlyEmitFirstEvent": true
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=VISHAL\\SQLEXPRESS;Database=TelePieWork2.0;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=false",
    "Hangfire": "Server=VISHAL\\SQLEXPRESS;Database=TelePieWork2.0;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=false",
    "SqlServer": "Server=VISHAL\\SQLEXPRESS;Database=TelePieWork2.0;User Id=sa;Password=YourPassword;TrustServerCertificate=True;MultipleActiveResultSets=false"
  },
  "Sql": {
    "CommandTimeoutSeconds": 600
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "Pie2.0",
    "Audience": "Pie2.0",
    "ExpirationMinutes": "1440",
    "RefreshTokenExpirationDays": "7"
  },
  "PasswordSalt": "YourPasswordSaltKeyChangeInProduction",
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Username": "x",
    "Password": "x"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "QueueLimit": 2
  },
  "Pagination": { "DefaultPageSize": 10 },
  "Hangfire": {
    "PayrollWorkerCount": 1,
    "PayrollProcessingTimeoutMinutes": 120,
    "PayrollMaxAttempts": 3
  },
  "Payroll": {
    "UseStoredProcedure": true,
    "UseLegacyCompanyProcessor": false,
    "DefaultCountryIso2": "SA"
  },
  "DefaultCountry": {
    "Iso2": "SA"
  },
  "PublicHolidaySync": {
    "Provider": "Calendarific",
    "CountryCode": "SA",
    "SyncYearsAhead": 1,
    "NationalHolidayPrimaryType": "National holiday"
  },
  "Calendarific": {
    "BaseUrl": "https://calendarific.com/api/v2",
    "ApiKey": "GX5o3M6nR85dp6I3P9GobG0s7TU53tGA"
  },
  "ImportStorage": {
